# ── dependencies, OS and editor files ────────────────────────────────────────
node_modules
.DS_Store
.claude
.vscode/
.idea/
*.log
npm-debug.log*

# ── environment: every env file except the example ───────────────────────────
# (.notenv is the Supabase .env set aside while the embedded build runs)
.env
*.env
.env.*
!.env.example
.notenv

# ── what the embedded build writes at runtime ────────────────────────────────
# the database, uploaded files and secrets (embedded.js); the daily archives (utils/backup.js);
# the LaunchDaemon's stdout/stderr (deploy/)
data/
backups/
logs/

# ── working notes: change logs and hand-over docs stay local, they are not the product ──
*_CHANGES.md
ADMIN_PROVISIONING_GUIDE.md
ENGINE_INTEGRATION.md
reference/

# ── stale SQLite database from before the Postgres migration (removed 2026-10-05) ──
crm.db
crm.db-shm
crm.db-wal
