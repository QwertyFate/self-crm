# Copy to .env and fill in. `npm start` and `npm run dev` both pass --env-file=.env,
# so the real file must be named exactly .env. Never commit it — only this example.
# Every variable below is one the code actually reads (grep process.env).

# ── Database (required) ───────────────────────────────────────────────────────
# Postgres connection string. The app creates one pool from this at boot.
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to false only for a local Postgres without TLS. Anything else enables SSL.
DATABASE_SSL=

# ── Server (required) ─────────────────────────────────────────────────────────
# Signs session cookies. Use a long random string; changing it logs everyone out.
SESSION_SECRET=
PORT=3000
NODE_ENV=development

# ── Admin console (required to use it) ────────────────────────────────────────
# The shared secret that gates the admin routes. Without it they return 503,
# which is the intended "off" state — there is no fixed admin URL.
ADMIN_SECRET=

# ── Task attachments (optional) ───────────────────────────────────────────────
# Supabase Storage, bucket "task-attachments". Uploading without these throws a
# clear error; the rest of the app works fine.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Email (optional) ──────────────────────────────────────────────────────────
# Password resets and invite emails. Without these, those emails are not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Used to build links inside those emails.
APP_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# ── Outbound engine integration (optional) ────────────────────────────────────
# Set to true to allow engine deliveries to private/localhost URLs. Development
# only — it disables a guard against pointing deliveries at internal hosts.
ENGINE_ALLOW_PRIVATE_URLS=

# ── Tests only ────────────────────────────────────────────────────────────────
# Overrides the repo root the test helpers resolve files against. Normally unset.
TEST_APP_ROOT=
