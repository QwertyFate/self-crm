
# Supabase / PostgreSQL — Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_SSL=true
BASE_URL=http://localhost:3000

# Platform admin console. Both values are required to enable it; leave
# ADMIN_CONSOLE_PATH empty to disable the console entirely.
#   ADMIN_SECRET       — login secret. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   ADMIN_CONSOLE_PATH — unguessable URL the console and its API are served under.
#                        Generate: node -e "console.log('/' + require('crypto').randomBytes(16).toString('hex'))"
ADMIN_SECRET=
ADMIN_CONSOLE_PATH=
SESSION_SECRET=myexample-secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=CRM <you@gmail.com>

# Google Drive file sync for the per-contact onboarding folder. Folders are
# shared "Anyone with the link"; the key only identifies this app to Google
# (read-only, no user login). One-time developer setup: Google Cloud Console →
# APIs & Services → enable "Google Drive API" → Credentials → Create API key →
# restrict it to the Drive API. Without it the folder link still shows, only
# the file list is off. Optional: DRIVE_SYNC_INTERVAL_MIN (default 15) is how
# often the background sync runs, DRIVE_SYNC_MAX_AGE_MIN (default 60) how old
# a contact's list may be before it is re-read.
GOOGLE_API_KEY=