
# Supabase / PostgreSQL — Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_SSL=true
BASE_URL=http://localhost:3000

# Admin panel secret — set this to enable the platform admin panel at /?admin
ADMIN_SECRET=change-me-to-something-secret
SESSION_SECRET=234Wersdfxcv!

# Upgrads Engine webhook: the Engine URL is set per workspace on the Integrations page.
# Private / loopback hosts are refused; set this to 1 only for local development against a local Engine.
# ENGINE_ALLOW_PRIVATE_URLS=1

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=CRM <you@gmail.com>