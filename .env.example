# Copy to .env and fill in. `npm start` and `npm run dev` both pass --env-file-if-exists=.env,
# so the real file must be named exactly .env (and the app also boots without one, for a host
# that injects variables). Never commit it — only this example. In production NODE_ENV is set
# by the launchd plist (deploy/), not here.
# Every variable below is one the code actually reads (grep process.env).

# ── Database (required) ───────────────────────────────────────────────────────
# Postgres connection string. The app creates one pool from this at boot.
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to false only for a local Postgres without TLS. Anything else enables SSL.
DATABASE_SSL=

# ── Server (required) ─────────────────────────────────────────────────────────
# Signs session cookies. Use a long random string; changing it logs everyone out.
SESSION_SECRET=
PORT=3000
NODE_ENV=development

# ── Admin console (required to use it) ────────────────────────────────────────
# The shared secret that gates the admin routes. Without it they return 503,
# which is the intended "off" state — there is no fixed admin URL.
ADMIN_SECRET=
# Its value is also the password of the internal team's tools (internal-tools/,
# a separate app at a fixed secret path, see server.js); unlocking those opens
# nothing else. They send audio to the Notetaker at localhost:8000 without a
# token; only if that ever changes:
# INTERNAL_TOOLS_TRANSCRIBE_URL=http://localhost:8000/crm/transcribe
# INTERNAL_TOOLS_TRANSCRIBE_TOKEN=

# ── File storage (optional) ───────────────────────────────────────────────────
# Supabase Storage. Two buckets: "task-attachments" (public) for files on tasks and
# a PRIVATE bucket for contact documents (contracts, call recordings — what the
# Upgrads Engine fetches through signed links). Create the private bucket in
# Supabase; SUPABASE_DOCS_BUCKET renames it (default "contact-documents").
# Uploading without the two keys throws a clear error; the rest of the app works fine.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# SUPABASE_DOCS_BUCKET=contact-documents

# ── Email (optional) ──────────────────────────────────────────────────────────
# Password resets and invite emails. Without these, those emails are not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Used to build links inside those emails. BASE_URL is also the public origin the
# Upgrads Engine gets in download_url values (utils/base-url.js); APP_BASE_URL
# overrides it for that purpose alone. Unset → the request's own host is used.
APP_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# ── Outbound engine integration (optional) ────────────────────────────────────
# Set to true to allow engine deliveries to private/localhost URLs. Development
# only — it disables a guard against pointing deliveries at internal hosts.
ENGINE_ALLOW_PRIVATE_URLS=

# ── Notetaker, the recording bot for Google Meet (optional) ───────────────────
# Used when a meeting is booked on Google Meet with "Mit Notetaker aufzeichnen" ticked.
# Where the CRM asks for the bot (default below), the token the service expects (sent as
# Authorization: Bearer <token>; leave empty and no header is sent), and where the service
# sends the finished notes (default http://localhost:<PORT>/api/notetaker/webhook; each
# meeting gets its own secret link under it, and the notes land on that meeting's deal).
# NOTETAKER_URL=http://localhost:8000/crm/recordings
# NOTETAKER_CRM_TOKEN=
# NOTETAKER_CALLBACK_URL=http://localhost:3000/api/notetaker/webhook
# Recommended: the same value as NOTETAKER_WEBHOOK_SECRET in the Notetaker's .env. When set,
# a result without the Notetaker's signature is refused.
# NOTETAKER_WEBHOOK_SECRET=

# ── The landing page's request form (/landingpagetwo, optional) ──────────────
# The inbound webhook address of the workspace that should receive requests from the
# landing page, copied from Integrations → Webhook in that workspace. Map name, email,
# company, phone and message there and switch on "create a deal". Empty: the page sends
# requests by email to team@upgrads.de instead.
# LANDING_LEAD_URL=

# ── Tests only ────────────────────────────────────────────────────────────────
# Overrides the repo root the test helpers resolve files against. Normally unset.
TEST_APP_ROOT=
