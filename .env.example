
# Supabase / PostgreSQL — Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_SSL=true
BASE_URL=http://localhost:3000

# Platform admin console. Both values are required to enable it; leave
# ADMIN_CONSOLE_PATH empty to disable the console entirely.
#   ADMIN_SECRET       — login secret. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   ADMIN_CONSOLE_PATH — unguessable URL the console and its API are served under.
#                        Generate: node -e "console.log('/' + require('crypto').randomBytes(16).toString('hex'))"
ADMIN_SECRET=
ADMIN_CONSOLE_PATH=
SESSION_SECRET=myexample-secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=CRM <you@gmail.com>