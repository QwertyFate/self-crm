# OPTIONAL. No .env is needed: the CRM runs fully local out of the box — the database, uploaded
# files and secrets under data/, a daily backup under backups/, signup and the admin console open,
# port 4001. Copy this file to .env only to change one of the few things below. The file must be
# named exactly .env (npm start and npm run dev load it); never commit it.

# The address people use to reach the CRM — behind a proxy: https://crm.upgrads.de. Shown in the
# "CRM running at …" boot line, used for the webhook URL on the Integrations page and for the links
# the admin console hands out. Unset → the address each request came in on.
BASE_URL=

# The port the server listens on.
PORT=4001

# Where the daily backup archive goes (one per day while the CRM runs, the newest BACKUP_KEEP kept;
# BACKUPS=0 switches the daily archive off, the console buttons and npm run backup still work).
# Default ./backups beside data/ — put it on another disk or a synced folder, so a backup survives
# the loss of this one.
# BACKUP_DIR=/Volumes/Backup/crm-backups
# BACKUP_KEEP=14
# BACKUPS=

# Running under a URL: switches on the strict Content-Security-Policy.
# NODE_ENV=production
